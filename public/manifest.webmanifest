  "categories": ["shopping", "marketplace", "lifestyle"],
  "shortcuts": [
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search for listings",
      "url": "/listings?search=true",
      "icons": [{ "src": "https://res.cloudinary.com/dqqycsgmn/image/upload/b_rgb:FFFFFF/e_improve,e_sharpen/v1747912623/selify_fav_icon_kejjeh.png", "sizes": "96x96", "border-radius": "5px" }]
    },
    {
      "name": "Post New Listing",
      "short_name": "Sell",
      "description": "Post a new item for sale",
      "url": "/seller/listings/create",
      "icons": [{ "src": "https://res.cloudinary.com/dqqycsgmn/image/upload/b_rgb:FFFFFF/e_improve,e_sharpen/v1747912623/selify_fav_icon_kejjeh.png", "sizes": "96x96", "border-radius": "5px" }]
    },
    {
      "name": "Messages",
      "short_name": "Chats",
      "description": "View your messages",
      "url": "/chat",
      "icons": [{ "src": "https://res.cloudinary.com/dqqycsgmn/image/upload/b_rgb:FFFFFF/e_improve,e_sharpen/v1747912623/selify_fav_icon_kejjeh.png", "sizes": "96x96", "border-radius": "5px" }]
    }
